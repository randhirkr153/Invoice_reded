# Server configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/invoice-db?retryWrites=true&w=majority

# JWT Authentication
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_123456
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_987654
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
